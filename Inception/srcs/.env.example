# ---------------------------------------------------------------------------
# srcs/.env.example  —  TEMPLATE. Copy to srcs/.env and edit.
#
#   cp srcs/.env.example srcs/.env
#
# srcs/.env is git-ignored (see Inception/.gitignore).
#
# RULE (subject, ch. V): "it is mandatory to use environment variables" and
# "it is mandatory to use a .env file to store environment variables".
#
# RULE (subject, ch. V): "No password must be present in your Dockerfiles."
# Therefore this file holds ONLY non-confidential configuration.
# Every password lives in ../secrets/*.txt and is mounted by Docker as a
# secret at /run/secrets/<name> inside the container.
# ---------------------------------------------------------------------------

# The domain must be login.42.fr and must resolve to the VM's local IP
# (add "127.0.0.1 akuzmin.42.fr" to /etc/hosts inside the VM).
DOMAIN_NAME=akuzmin.42.fr

# --- MariaDB -----------------------------------------------------------------
# MYSQL_HOST is the *service name* from docker-compose.yml. Docker's embedded
# DNS server (127.0.0.11) resolves it to the mariadb container's IP on the
# user-defined bridge network. This is why `links:` is both forbidden and
# unnecessary.
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- WordPress ---------------------------------------------------------------
WP_TITLE=Inception
WP_URL=https://akuzmin.42.fr

# RULE (subject, ch. V): the administrator's username can NOT contain
# admin / Admin / administrator / Administrator. "siteowner" is safe.
WP_ADMIN_USER=siteowner
WP_ADMIN_EMAIL=siteowner@student.42.fr

# The second, non-administrator user required by the subject.
WP_USER=visitor
WP_USER_EMAIL=visitor@student.42.fr
WP_USER_ROLE=author

# ===========================================================================
# BONUS SERVICES
# ===========================================================================

# --- Redis object cache ------------------------------------------------------
# Host is the compose service name, resolved by Docker's embedded DNS.
# Set WP_REDIS_ENABLED=0 to run the mandatory stack without the cache.
WP_REDIS_ENABLED=1
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379

# --- FTP ---------------------------------------------------------------------
# The password lives in secrets/ftp_password.txt, never here.
FTP_USER=ftpuser
# Address the server advertises for PASSIVE data connections. It must be the
# address the CLIENT uses to reach the host — not the container's IP. Wrong
# value = login succeeds but every transfer hangs.
FTP_PASV_ADDRESS=127.0.0.1

# --- Automated database backup -----------------------------------------------
# Standard 5-field cron expression. Default: daily at 03:00.
BACKUP_SCHEDULE=0 3 * * *
# How many dumps to keep. Older ones are rotated out, so the volume cannot grow
# without bound and fill the disk MariaDB is running on.
BACKUP_KEEP=7
