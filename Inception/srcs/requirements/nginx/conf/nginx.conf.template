# ---------------------------------------------------------------------------
# NGINX main configuration (rendered from this template by envsubst).
# Replaces /etc/nginx/nginx.conf entirely, so every directive in effect is
# visible in this one file — nothing is inherited from a Debian default.
# ---------------------------------------------------------------------------

# WHY the master runs as root but the workers as www-data: only root can bind
# to a privileged port (<1024) such as 443. The master binds it, then forks
# workers that immediately drop to www-data and handle every request.
user  www-data;

# One worker per CPU core. `auto` lets NGINX read the core count at start-up
# instead of hardcoding a number that would be wrong on another machine.
worker_processes auto;

# Log to stderr so `docker compose logs nginx` shows errors. A container has no
# logrotate; writing to a file inside the container would grow without bound and
# be invisible to the operator.
error_log  /dev/stderr warn;
pid        /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log  /dev/stdout;

    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout 65;

    # Hide the exact NGINX version from response headers and error pages —
    # it tells an attacker which CVEs to try.
    server_tokens off;

    # WordPress media uploads are larger than the 1 MB default.
    client_max_body_size 32m;

    server {
        # ssl + http2 on 443. No `listen 80` anywhere: the subject permits port
        # 443 only. No IPv6 listener either: inception-network is IPv4-only, and
        # on a kernel with IPv6 disabled `listen [::]:443` stops nginx from starting.
        #
        # NOTE on the http2 syntax: Debian bookworm ships nginx 1.22, where
        # HTTP/2 is a parameter of `listen`. The standalone `http2 on;`
        # directive only exists from nginx 1.25.1 and makes 1.22 fail to start
        # with `unknown directive "http2"`. Since the base image is pinned to
        # bookworm, the 1.22 form is the correct one here.
        listen      443 ssl http2;

        server_name ${DOMAIN_NAME};

        # Self-signed certificate generated by entrypoint.sh at start-up.
        ssl_certificate     /etc/nginx/ssl/inception.crt;
        ssl_certificate_key /etc/nginx/ssl/inception.key;

        # THE mandatory line of this project.
        # Subject: "NGINX with TLSv1.2 or TLSv1.3 only."
        # Naming exactly these two protocols disables SSLv3, TLS 1.0 and TLS 1.1,
        # all of which are broken (POODLE, BEAST) and all of which NGINX would
        # otherwise happily negotiate. Verify with:
        #   openssl s_client -connect akuzmin.42.fr:443 -tls1_1   -> must FAIL
        #   openssl s_client -connect akuzmin.42.fr:443 -tls1_2   -> must succeed
        ssl_protocols TLSv1.2 TLSv1.3;

        # Modern AEAD suites only; forward secrecy via ECDHE, so a leaked
        # private key cannot decrypt previously captured traffic.
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        # This is the wordpress-data named volume, mounted read-only here and
        # read-write in the WordPress container. NGINX serves the static assets
        # (css/js/images) straight off disk; only .php goes to PHP-FPM.
        root  /var/www/html;
        index index.php index.html;

        # WordPress permalinks: /2026/08/my-post/ is not a real file. Try the
        # literal path, then the directory, and otherwise hand the request to
        # index.php, which routes it. Without this, every post 404s.
        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        # wp-config.php holds the database password; .htaccess and dotfiles are
        # Apache leftovers that must never be downloadable. Regex locations are
        # tried in file order, so the dotfile rule must come before the .php rule.
        location ~ /\. {
            deny all;
        }
        location = /wp-config.php {
            deny all;
        }

        location ~ \.php$ {
            # Reject requests where the .php part does not end the path
            # (/foo.php/bar.jpg). Combined with the SCRIPT_FILENAME check below
            # this closes the classic PHP path-info RCE.
            try_files $uri =404;

            include       /etc/nginx/fastcgi_params;

            # `wordpress` is the compose service name, resolved by Docker's
            # embedded DNS at 127.0.0.11 to that container's IP on
            # inception-network.
            fastcgi_pass  wordpress:9000;
            fastcgi_index index.php;

            # The absolute path PHP-FPM must execute. Both containers mount the
            # same volume at the same path, so this filename is valid on the
            # other side of the network too.
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

            # Debian's fastcgi_params passes HTTP_HOST as $host, which drops the port.
            # On a non-default port WordPress would then see a URL different from
            # WP_HOME and redirect to itself forever. $http_host keeps the port.
            fastcgi_param HTTP_HOST $http_host;

            # TLS terminates here, so the FastCGI request itself is plaintext.
            # Telling PHP that the *client* connection was HTTPS makes
            # is_ssl() true, so WordPress emits https:// URLs and sets the
            # `secure` flag on its cookies.
            fastcgi_param HTTPS on;

            fastcgi_read_timeout 60s;
        }
    }
}
